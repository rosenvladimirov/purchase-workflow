<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="1">
        <!-- Demo Product Template -->
        <record id="product_product_secondary_unit_demo" model="product.template">
            <field name="name">Demo Product - Screws</field>
            <field name="type">product</field>
            <field name="categ_id" ref="product.product_category_all" />
            <field name="uom_id" ref="uom.product_uom_unit" />
            <field name="uom_po_id" ref="uom.product_uom_unit" />
            <field name="standard_price">0.50</field>
            <field name="list_price">1.00</field>
            <field name="description">Demo product for testing secondary units with editable factor</field>
        </record>

        <!-- Demo Secondary Unit - Box (1 Box = 100 Units) -->
        <record id="product_secondary_unit_box_demo" model="product.secondary.unit">
            <field name="name">Box</field>
            <field name="code">BOX</field>
            <field
                name="product_tmpl_id"
                ref="product_product_secondary_unit_demo"
            />
            <field name="factor">100.0</field>
            <field name="uom_id" ref="uom.product_uom_unit" />
        </record>

        <!-- Demo Secondary Unit - Pallet (1 Pallet = 2000 Units) -->
        <record id="product_secondary_unit_pallet_demo" model="product.secondary.unit">
            <field name="name">Pallet</field>
            <field name="code">PLT</field>
            <field
                name="product_tmpl_id"
                ref="product_product_secondary_unit_demo"
            />
            <field name="factor">2000.0</field>
            <field name="uom_id" ref="uom.product_uom_unit" />
        </record>

        <!-- Demo Product Template 2 -->
        <record id="product_product_secondary_unit_demo_2" model="product.template">
            <field name="name">Demo Product - Cables</field>
            <field name="type">product</field>
            <field name="categ_id" ref="product.product_category_all" />
            <field name="uom_id" ref="uom.product_uom_meter" />
            <field name="uom_po_id" ref="uom.product_uom_meter" />
            <field name="standard_price">2.50</field>
            <field name="list_price">5.00</field>
            <field name="description">Demo product for cables with roll packaging</field>
        </record>

        <!-- Demo Secondary Unit - Roll (1 Roll = 50 Meters) -->
        <record id="product_secondary_unit_roll_demo" model="product.secondary.unit">
            <field name="name">Roll</field>
            <field name="code">ROLL</field>
            <field
                name="product_tmpl_id"
                ref="product_product_secondary_unit_demo_2"
            />
            <field name="factor">50.0</field>
            <field name="uom_id" ref="uom.product_uom_meter" />
        </record>
    </data>
</odoo>
