<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Purchase Order Form View - Tree Section -->
    <record id="purchase_order_form_secondary_unit" model="ir.ui.view">
        <field name="name">purchase.order.form.secondary.unit</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form" />
        <field name="arch" type="xml">
            <!-- Add fields to order a line tree -->
            <xpath
                expr="//field[@name='order_line']/form//field[@name='product_qty']"
                position="before"
            >
                <field name="secondary_uom_factor" readonly="state in ['purchase','done', 'cancel']"/>
                <field name="secondary_uom_factor_editable" force_save="1"/>
            </xpath>
            <xpath
                expr="//field[@name='order_line']/list//field[@name='product_qty']"
                position="before"
            >
                <field name="secondary_uom_factor" optional="hide" />
                <field name="secondary_uom_factor_editable" optional="hide" force_save="1"/>
            </xpath>
        </field>
    </record>
</odoo>
